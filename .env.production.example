# Host paths used by bin/bootstrap-production.sh and bin/deploy-local.sh.
# Production data defaults to the ignored repository-local production/ directory.
# GIG_FINDER_PRODUCTION_ROOT=/absolute/override/path
GIG_FINDER_CODEX_HOME=/absolute/path/to/codex-home

# Optional deployment overrides.
GIG_FINDER_IMAGE=ghcr.io/paulmccallick/gig-finder
GIG_FINDER_CONTAINER_NAME=gig-finder
