# Unix production paths used by bin/bootstrap-production.sh and bin/deploy-local.sh.
GIG_FINDER_PRODUCTION_ROOT=/var/lib/gig-finder
GIG_FINDER_LOG_ROOT=/var/log/gig-finder
GIG_FINDER_BACKUP_ROOT=/var/backups/gig-finder
GIG_FINDER_CONFIG=/etc/gig-finder/config.json
GIG_FINDER_CODEX_HOME=/absolute/path/to/codex-home

# Optional deployment overrides.
GIG_FINDER_IMAGE=ghcr.io/paulmccallick/gig-finder
GIG_FINDER_CONTAINER_NAME=gig-finder
