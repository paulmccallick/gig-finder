{
  "name": "job-search-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run src/web/dev.ts",
    "dev:api": "NODE_ENV=development AI_SDK_DEVTOOLS=true bun --watch src/web/server.ts",
    "dev:client": "vite --config src/web/vite.config.ts --host 127.0.0.1",
    "dev:inspect": "bunx @ai-sdk/devtools",
    "dev:restart": "bun run src/web/restart-dev.ts",
    "typecheck": "tsc --noEmit -p src/core/tsconfig.json && tsc --noEmit -p src/sqlite/tsconfig.json && tsc --noEmit -p src/cli/tsconfig.json && tsc --noEmit -p src/web/tsconfig.json",
    "test": "bun test src/core/test src/sqlite/test src/cli/test src/agent/test src/web/src src/web/server",
    "test:e2e": "playwright test --config src/web/playwright.config.ts",
    "build": "bun run typecheck && vite build --config src/web/vite.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "test:core": "bun test src/core/test",
    "test:sqlite": "bun test src/sqlite/test",
    "cli": "bin/job-search"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.18",
    "@ai-sdk/react": "4.0.38",
    "ai": "7.0.35",
    "drizzle-orm": "^0.45.2",
    "mammoth": "1.12.0",
    "pdfjs-dist": "6.2.108",
    "pino": "^10.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rotating-file-stream": "^3.2.9",
    "turndown": "7.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "^1.0.7",
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.10",
    "jszip": "3.10.1",
    "mdast-util-to-string": "^4.0.0",
    "pdf-lib": "1.17.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^7.1.9"
  }
}
