{
  "name": "gig-finder",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:api": "AI_SDK_DEVTOOLS=true PORT=3101 bun --watch src/web/server.ts",
    "dev:client": "vite --config src/web/vite.config.ts --host 127.0.0.1",
    "dev:inspect": "bunx @ai-sdk/devtools",
    "dev:restart": "bun run src/web/restart-dev.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "architecture": "depcruise src --config .dependency-cruiser.cjs",
    "test": "bun test src/core/test src/data/test src/cli/test src/agent/test src/web scripts/smoke-support",
    "check": "bun run lint && bun run typecheck && bun run architecture && bun run test",
    "test:e2e": "playwright test --config src/web/playwright.config.ts",
    "smoke:deterministic": "bun run scripts/smoke.ts deterministic",
    "smoke:live": "bun run scripts/smoke.ts live",
    "build:clean": "bun -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\"",
    "build:client": "vite build --config src/web/vite.config.ts",
    "build:server:web": "bun build src/web/server.ts --root=src/web --target=bun --production --outdir=dist/server --sourcemap=external",
    "build:server:maintenance": "bun build src/operations/maintenance.ts --root=src/operations --target=bun --production --outdir=dist/server --sourcemap=external",
    "build:server:smoke-provider": "bun build src/operations/smoke-provider-server.ts --root=src/operations --target=bun --production --outdir=dist/server --sourcemap=external",
    "build:server:assets": "bun -e \"import { copyFile } from 'node:fs/promises'; await copyFile('node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs', 'dist/server/pdf.worker.mjs')\"",
    "build:server": "bun run build:server:web && bun run build:server:maintenance && bun run build:server:smoke-provider && bun run build:server:assets",
    "build:verify": "bun run scripts/verify-production-bundles.ts",
    "build": "bun run build:clean && bun run build:client && bun run build:server && bun run build:verify",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:migrate": "bun run src/operations/migrate.ts",
    "test:core": "bun test src/core/test",
    "test:data": "bun test src/data/test",
    "cli": "bin/gig-finder"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.18",
    "@ai-sdk/react": "4.0.38",
    "ai": "7.0.35",
    "drizzle-orm": "^0.45.2",
    "mammoth": "1.12.0",
    "pdfjs-dist": "6.2.108",
    "pino": "^10.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rotating-file-stream": "^3.2.9",
    "turndown": "7.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "^1.0.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "^5.0.4",
    "dependency-cruiser": "^18.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "jszip": "3.10.1",
    "mdast-util-to-string": "^4.0.0",
    "pdf-lib": "1.17.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "unified": "^11.0.5",
    "vite": "^7.1.9"
  }
}
